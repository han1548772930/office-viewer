{
  "name": "@office-studio/office-studio",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "./dist/office-studio.css",
    "./src/features/document/code-blocks/document-code-prism-config.ts"
  ],
  "files": ["dist", "src", "README.md"],
  "main": "./dist/office-studio.js",
  "module": "./dist/office-studio.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/office-studio.js"
    },
    "./style.css": "./dist/office-studio.css"
  },
  "scripts": {
    "check:types": "vue-tsc -p tsconfig.json --noEmit",
    "build": "vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist/types && vite build"
  },
  "dependencies": {
    "dayjs": "1.11.23",
    "echarts": "6.1.0",
    "prismjs": "1.30.0"
  },
  "peerDependencies": {
    "antdv-next": ">=1.8.2",
    "lucide-vue-next": ">=1.0.0",
    "pinia": ">=4.1.0",
    "vue": ">=3.5.0",
    "vue-i18n": ">=11.4.18 <12"
  },
  "devDependencies": {
    "@types/prismjs": "1.26.5"
  }
}
