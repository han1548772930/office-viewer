{
  "name": "office-viewer-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "check:types": "pnpm --filter @office-studio/office-studio check:types && pnpm --filter @office-studio/workbench check:types",
    "build": "pnpm --filter @office-studio/office-studio build && pnpm --filter @office-studio/workbench build",
    "build:wasm": "wasm-pack build crates/office-parser --target web --release --out-dir ../../public/wasm --out-name office_parser",
    "build:compute": "wasm-pack build crates/office-compute --target web --release --out-dir ../../public/compute --out-name office_compute",
    "build:writer": "wasm-pack build crates/office-writer --target web --release --out-dir ../../public/wasm-writer --out-name office_writer",
    "build:bridge": "wasm-pack build crates/office-wasm-bridge --target web --release --out-dir ../../public/wasm-bridge --out-name office_wasm_bridge",
    "generate:document-characters": "node scripts/generate-document-emojis.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:compute": "vitest run --config vitest.config.ts packages/office-studio/tests/compute-index-service.contract.test.mjs",
    "test:benchmark:smoke": "vitest run --config vitest.benchmark.config.ts",
    "test:parser": "cargo test --manifest-path crates/office-parser/Cargo.toml",
    "test:api": "vitest run --config vitest.config.ts packages/office-studio/tests/document-facade.contract.test.mjs packages/office-studio/tests/office-api.contract.test.mjs",
    "test:browser": "playwright test --config tests/browser/office-workbench.playwright.config.ts",
    "test:browser:features": "playwright test --config tests/browser/feature-panels.playwright.config.ts",
    "test:browser:toolbars": "playwright test --config tests/browser/toolbar-parity.playwright.config.ts",
    "test:browser:docs": "playwright test --config tests/browser/workbench.playwright.config.ts",
    "test:browser:charts": "playwright test --config tests/browser/chart-workbench.playwright.config.ts",
    "test:browser:compute": "playwright test --config tests/browser/playwright.config.ts",
    "test:browser:production": "playwright test --config tests/browser/production-office-io.playwright.config.ts",
    "dev": "pnpm --filter @office-studio/workbench dev",
    "preview": "pnpm --filter @office-studio/workbench preview"
  },
  "dependencies": {
    "@antdv-next/icons": "^1.1.2",
    "antdv-next": "^1.8.2",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "@webgpu/types": "^0.1.74",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
